# InsForge (npx @insforge/cli secrets get ANON_KEY; URL from .insforge/project.json)
NEXT_PUBLIC_INSFORGE_URL=https://<appkey>.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Admin key: server-only (published pages, Discover, Remix)
INSFORGE_API_KEY=

# LLM via InsForge Model Gateway (npx @insforge/cli ai setup). Server-only.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Alex. Use anthropic/claude-haiku-5.5 during development to save credit.
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-5.5
# Mike / Emma / Bob
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5
# 1 = replay fixtures/*.jsonl instead of calling the model
LLM_MOCK=1

# Demo account (server-only, used by the "try demo" Server Action)
DEMO_EMAIL=
DEMO_PASSWORD=

# Generations per user per day
DAILY_LIMIT=30
DAILY_LIMIT_DEMO=10
