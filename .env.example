# InsForge (npx @insforge/cli secrets get ANON_KEY; URL from .insforge/project.json)
NEXT_PUBLIC_INSFORGE_URL=https://<appkey>.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Admin key: server-only (published pages, Discover, Remix)
INSFORGE_API_KEY=

# LLM via InsForge Model Gateway (npx @insforge/cli ai setup). Server-only.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Alex. Production and development use Haiku to conserve demo credit.
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
# Mike / Emma / Bob
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5
# 1 = replay fixtures/*.json instead of calling the model
LLM_MOCK=1

# Demo account (server-only, used by the "try demo" Server Action)
DEMO_EMAIL=
DEMO_PASSWORD=

# Generations per user per day
DAILY_LIMIT=30
DAILY_LIMIT_DEMO=10

# Optional local fixture recording; never enabled in production
RECORD_FIXTURES=0

# Optional: isolate parallel local dev/build processes
# NEXT_DIST_DIR=.next-dev
