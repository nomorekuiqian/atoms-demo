    {
      "id": "5b6c0d13-6e28-4ed3-9edf-51d8ab9042df",
      "number": 107,
      "files": {
        "app.js": "(function () {\n  \"use strict\";\n\n  var KEY = \"counter-value\";\n  var countEl = document.getElementById(\"count\");\n  var addBtn = document.getElementById(\"add\");\n  var resetBtn = document.getElementById(\"reset\");\n\n  function load() {\n    try {\n      var raw = window.localStorage.getItem(KEY);\n      var n = parseInt(raw, 10);\n      return isNaN(n) ? 0 : n;\n    } catch (e) {\n      return 0;\n    }\n  }\n\n  function save(value) {\n    try {\n      window.localStorage.setItem(KEY, String(value));\n    } catch (e) {\n      /* storage unavailable; counter still works in memory */\n    }\n  }\n\n  var count = load();\n\n  function render() {\n    if (countEl) countEl.textContent = String(count);\n  }\n\n  function setCount(value) {\n    count = value;\n    save(count);\n    render();\n  }\n\n  if (addBtn) {\n    addBtn.addEventListener(\"click\", function () {\n      setCount(count + 1);\n    });\n  }\n\n  if (resetBtn) {\n    resetBtn.addEventListener(\"click\", function () {\n      setCount(0);\n    });\n  }\n\n  render();\n})();",
        "index.html": "<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width\"><title>Counter</title></head><body><main><h1>Counter</h1><output id=\"count\">0</output><button id=\"add\">Add</button><button id=\"reset\">Reset</button></main><script src=\"app.js\"></script></body></html>"
      },
